#!/bin/bash
#SBATCH -p fat4way
#SBATCH -o 11rounds_%j.out        
#SBATCH -e 11rounds_%j.err         
#SBATCH -N 1 
#SBATCH --no-requeue
#SBATCH -A huzeng_g1
#SBATCH --qos=huzengf4w
#SBATCH -c 4

for i in $(seq -f "Position%03g" 1 1)
do
    matlab -batch "core_matlab('p1test', 'global_registration', '$i', 3072, 42, 1, 3, 11, '/home/huzeng_pkuhpc/gpfs3/yly/20250114mousebrain', '01_data', '02_registration', 'log', 'sqrt_pieces', 4)"
done

